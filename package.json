{
  "name": "college-erp",
  "version": "1.0.0",
  "description": "Full-Featured Enterprise Resource Planning (ERP) System for Zeal Education Society, Induri Campus",
  "scripts": {
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
