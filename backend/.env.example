# College ERP Production Environment Variables Example
PORT=5000
NODE_ENV=production

# SQLite for fast zero-cost setup or PostgreSQL for high concurrency:
# SQLite (default):
DATABASE_URL="file:./erp.db"
# PostgreSQL (for Render / Railway PostgreSQL):
# DATABASE_URL="postgresql://postgres:password@host:5432/college_erp?schema=public"

# Security Secrets (Generate a strong random string in production)
JWT_SECRET="zes_zcoer_induri_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Allowed CORS origins (comma-separated, or leave empty in combined deployment)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5000"

# Academic & Institutional Defaults
COLLEGE_NAME="Zeal College of Engineering and Research"
COLLEGE_CODE="ZCOER"
ATTENDANCE_MIN_THRESHOLD=75.0
LIBRARY_FINE_PER_DAY=5.0
